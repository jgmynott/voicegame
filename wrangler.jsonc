// Cloudflare Workers config: static game files from docs/, plus a small game server
// (src/worker.js) that runs rooms for online play. Only /api/* reaches the server code.
{
  "name": "voicegame",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
