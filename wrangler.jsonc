// Cloudflare Workers config: static game files from docs/, plus a small game server
// (src/worker.js) that runs rooms for online play. The Worker sees every request so it can
// send www.backslang.io to backslang.io; non-API paths are passed straight to the static assets.
{
  "name": "voicegame",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "STATS", "class_name": "Stats" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Stats"] }],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  // Setting routes turns workers.dev off unless it is kept on explicitly.
  "workers_dev": true,
  "routes": [
    { "pattern": "backslang.io", "custom_domain": true },
    { "pattern": "www.backslang.io", "custom_domain": true }
  ]
}
