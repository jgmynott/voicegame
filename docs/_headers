# Cache rules for the static files (Cloudflare Workers static assets reads this file; it is not served).
# The font never changes under this name, so browsers may keep it for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Icons rarely change. Keep them a week.
/icon-*
  Cache-Control: public, max-age=604800

# Always check for a new service worker.
/sw.js
  Cache-Control: no-cache
